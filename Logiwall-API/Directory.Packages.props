<Project>
  <!-- Central Package Management: every package version lives here, never in a *.csproj.
       A project lists <PackageReference Include="X" /> with no Version. See
       docs/conventions/dotnet-and-deploy.md §13.2. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="ASP.NET Core and Identity">
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Authorization" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.WebUtilities" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Identity.Stores" Version="10.0.14" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="9.0.6" />
  </ItemGroup>

  <ItemGroup Label="Entity Framework Core">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.14" />
    <!-- Pinned for CVE fix (GHSA-846f-f764-76mx); remove when Microsoft.Data.SqlClient brings a patched version. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup Label="Microsoft.Extensions">
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Localization" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup Label="Health checks">
    <PackageVersion Include="AspNetCore.HealthChecks.System" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup Label="Logging">
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup Label="Libraries">
    <PackageVersion Include="FluentEmail.Smtp" Version="3.0.2" />
    <PackageVersion Include="Riok.Mapperly" Version="4.3.1" />
  </ItemGroup>

  <ItemGroup Label="bit platform">
    <PackageVersion Include="Bit.BlazorUI" Version="10.7.0" />
    <PackageVersion Include="Bit.BlazorUI.Assets" Version="10.7.0" />
    <PackageVersion Include="Bit.BlazorUI.Extras" Version="10.7.0" />
    <PackageVersion Include="Bit.BlazorUI.Icons" Version="10.7.0" />
    <PackageVersion Include="Bit.Bswup" Version="10.7.0" />
    <PackageVersion Include="Bit.Butil" Version="10.7.0" />
    <PackageVersion Include="Bit.CodeAnalyzers" Version="10.7.0" />
    <PackageVersion Include="Bit.SourceGenerators" Version="10.7.0" />
  </ItemGroup>

  <ItemGroup Label="Blazor clients">
    <PackageVersion Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup Label="MAUI client">
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="10.0.120" />
    <PackageVersion Include="Microsoft.Maui.Controls" Version="10.0.120" />
    <PackageVersion Include="Microsoft.Maui.Controls.Compatibility" Version="10.0.120" />
    <PackageVersion Include="Microsoft.Maui.Essentials" Version="10.0.120" />
    <PackageVersion Include="Oscore.Maui.AppStoreInfo" Version="1.0.7" />
    <PackageVersion Include="Plugin.StoreReview" Version="6.2.0" />
  </ItemGroup>

  <ItemGroup Label="Infrastructure as code">
    <PackageVersion Include="Pulumi.AzureNative" Version="2.59.0" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.16.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>
