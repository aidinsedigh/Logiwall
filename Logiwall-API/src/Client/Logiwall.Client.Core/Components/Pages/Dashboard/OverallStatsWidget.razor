@inherits AppComponentBase

<div class="card-container">
    <div class="card">
        <div class="card-num @(isLoading ? "no-border" : null)">
            @if (isLoading)
            {
                <BitSpinnerLoading Size="BitSize.Large" />
            }
            else
            {
                @data.TotalOrders
            }
        </div>
        <div class="card-title">@Localizer[nameof(AppStrings.TotalOrders)]</div>
    </div>
    <div class="card">
        <div class="card-num @(isLoading ? "no-border" : null)">
            @if (isLoading)
            {
                <BitSpinnerLoading Size="BitSize.Large" />
            }
            else
            {
                @data.Last30DaysOrders
            }
        </div>
        <div class="card-title">@Localizer[nameof(AppStrings.Last30DaysOrders)]</div>
    </div>
    <div class="card">
        <div class="card-num @(isLoading ? "no-border" : null)">
            @if (isLoading)
            {
                <BitSpinnerLoading Size="BitSize.Large" />
            }
            else
            {
                @data.PaidOrders
            }
        </div>
        <div class="card-title">@Localizer[nameof(AppStrings.PaidOrders)]</div>
    </div>
</div>
