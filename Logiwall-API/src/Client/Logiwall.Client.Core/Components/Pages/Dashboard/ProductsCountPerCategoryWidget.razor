@inherits AppComponentBase

<div class="card">
    <div class="card-header">
        <div class="title">@Localizer[nameof(AppStrings.ProductsCountPerCategoryChart)]</div>
        <div class="subtitle">@Localizer[nameof(AppStrings.ProductsCountPerCategoryChartText)]</div>
    </div>
    <div class="card-body">
        @if (isLoading)
        {
            <BitSpinnerLoading Size="BitSize.Large" />
        }
        else
        {
            <BitChart Config="config" @ref="chart" />
        }
    </div>
</div>


